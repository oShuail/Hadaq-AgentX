# Copy to .env (git-ignored). The Makefile loads it automatically.

# API (Turki)
DATABASE_URL=sqlite:///./data/hadaq.db
# DATABASE_URL=postgresql+psycopg://hadaq:hadaq@localhost:5432/hadaq   # with: docker compose --profile postgres up -d
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
PHOTO_DIR=./data/photos
API_PUBLIC_URL=http://localhost:8000
AGENTS_URL=http://localhost:8100
AGENTS_ENABLED=true
ANOMALY_COOLDOWN_S=600
PRIVACY_BLUR=true            # hide faces in uploaded photos before they are stored (needs OpenCV: make setup)
SENSOR_STALE_S=30

# Agents (Omar). "mock" runs the real tools with a fixed plan and needs no key.
API_URL=http://localhost:8000
HADAQ_LLM=mock
# HADAQ_LLM=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# HADAQ_LLM_EFFORT=medium    # low | medium | high: thinking depth on current models (medium = quick, good with tools)
# HADAQ_LLM_TIMEOUT_S=90
TRIGGER_COOLDOWN_S=60

# Simulation (Basma)
HADAQ_WEATHER_CACHE=./data/weather_cache

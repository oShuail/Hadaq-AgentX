# Copy to apps/web/.env.local (git-ignored)
VITE_API_URL=http://localhost:8000
VITE_AGENTS_URL=http://localhost:8100
# Free token from https://ion.cesium.com (Community plan, non-commercial): terrain + OSM buildings
VITE_CESIUM_ION_TOKEN=
# OSM elementId of the focus building: click it in the app, copy the id shown in the panel
VITE_FOCUS_OSM_ID=
# Optional: our own 3D model of the focus building (glTF/GLB in apps/web/public/models/)
VITE_FOCUS_MODEL_URL=
# Our own At-Turaif district model (tools/turaif_model/build_district.py). Leave empty to show only the OSM boxes
VITE_DISTRICT_URL=/models/turaif.glb
# 1 = Google Photorealistic 3D Tiles (real photo mesh of the site, via your Cesium ion token) instead of OSM boxes and our district model
VITE_GOOGLE_3D=0

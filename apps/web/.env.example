# Copy to apps/web/.env.local (git-ignored)
VITE_API_URL=http://localhost:8000
VITE_AGENTS_URL=http://localhost:8100
# Our own 3D model of the focus building (GLB in apps/web/public/models/, footprint JSON next to it)
VITE_FOCUS_MODEL_URL=/models/b01_v3.glb
# The 3D map itself needs no keys: it is baked once from open data into public/site/ (open /bake.html, see tools/site_data/README.md)

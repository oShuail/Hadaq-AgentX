{
  "$defs": {
    "CaptureQuality": {
      "description": "Checks made by the app at the shutter. Warnings never block a shot; they are recorded.",
      "properties": {
        "tilt_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tilt Ok"
        },
        "exposure": {
          "anyOf": [
            {
              "enum": [
                "ok",
                "dark",
                "bright"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exposure"
        },
        "blur_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blur Score"
        },
        "steady": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steady"
        },
        "scale_ref": {
          "default": false,
          "title": "Scale Ref",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "CaptureQuality",
      "type": "object"
    },
    "GeoFix": {
      "properties": {
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "accuracy_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accuracy M"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "GeoFix",
      "type": "object"
    },
    "Provenance": {
      "enum": [
        "measured",
        "derived",
        "model_output",
        "assumed",
        "synthetic"
      ],
      "title": "Provenance",
      "type": "string"
    }
  },
  "description": "The `meta` JSON part of the multipart upload, written by the surveyor app.",
  "properties": {
    "client_uuid": {
      "minLength": 8,
      "title": "Client Uuid",
      "type": "string"
    },
    "survey_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Survey Id"
    },
    "building_id": {
      "title": "Building Id",
      "type": "string"
    },
    "wall_id": {
      "title": "Wall Id",
      "type": "string"
    },
    "segment": {
      "default": "full",
      "title": "Segment",
      "type": "string"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "surveyor": {
      "title": "Surveyor",
      "type": "string"
    },
    "device": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device"
    },
    "source": {
      "default": "camera",
      "enum": [
        "camera",
        "import"
      ],
      "title": "Source",
      "type": "string"
    },
    "gps": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeoFix"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "heading_deg": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Heading Deg"
    },
    "tilt_deg": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tilt Deg"
    },
    "quality": {
      "$ref": "#/$defs/CaptureQuality"
    },
    "corners_px": {
      "anyOf": [
        {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corners Px"
    },
    "image_width_px": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Width Px"
    },
    "image_height_px": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Height Px"
    },
    "faces_hidden": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Faces Hidden"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance",
      "default": "measured"
    }
  },
  "required": [
    "client_uuid",
    "building_id",
    "wall_id",
    "captured_at",
    "surveyor"
  ],
  "title": "CaptureMeta",
  "type": "object"
}

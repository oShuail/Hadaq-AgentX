{
  "$defs": {
    "Citation": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "status": {
          "enum": [
            "approved_library",
            "team_proposal"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source",
        "status"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Finding": {
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "capture_id": {
          "title": "Capture Id",
          "type": "string"
        },
        "inspection_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inspection Id"
        },
        "building_id": {
          "title": "Building Id",
          "type": "string"
        },
        "wall_id": {
          "title": "Wall Id",
          "type": "string"
        },
        "zone_id": {
          "title": "Zone Id",
          "type": "string"
        },
        "damage_type": {
          "enum": [
            "plaster_loss",
            "crack",
            "base_erosion",
            "rain_grooves",
            "salt_efflorescence",
            "voids_burrows",
            "structural_deformation",
            "incompatible_repair",
            "parapet_loss",
            "timber_decay",
            "biological_growth"
          ],
          "title": "Damage Type",
          "type": "string"
        },
        "severity": {
          "enum": [
            1,
            2,
            3
          ],
          "title": "Severity",
          "type": "integer"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "suspected": {
          "default": false,
          "title": "Suspected",
          "type": "boolean"
        },
        "box_px": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Box Px"
        },
        "box_wall_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Box Wall M",
          "type": "array"
        },
        "polygon_wall_m": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon Wall M"
        },
        "length_cm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Cm"
        },
        "width_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width Mm"
        },
        "area_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area M2"
        },
        "change": {
          "anyOf": [
            {
              "enum": [
                "new",
                "grown",
                "unchanged",
                "repaired"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change"
        },
        "previous_finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Finding Id"
        },
        "lookalike": {
          "anyOf": [
            {
              "$ref": "#/$defs/Lookalike"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Priority"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review": {
          "$ref": "#/$defs/Review"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "default": "model_output"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "capture_id",
        "building_id",
        "wall_id",
        "zone_id",
        "damage_type",
        "severity",
        "confidence",
        "box_wall_m",
        "model"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Lookalike": {
      "description": "The photo cannot tell two damages apart; the agent asks for evidence instead of guessing.",
      "properties": {
        "pair_id": {
          "title": "Pair Id",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "evidence_needed": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Needed",
          "type": "array"
        },
        "note_ar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note Ar"
        }
      },
      "required": [
        "pair_id",
        "options",
        "evidence_needed"
      ],
      "title": "Lookalike",
      "type": "object"
    },
    "Priority": {
      "properties": {
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "criteria": {
          "$ref": "#/$defs/PriorityCriteria"
        },
        "escalation": {
          "enum": [
            "urgent",
            "high",
            "medium",
            "low"
          ],
          "title": "Escalation",
          "type": "string"
        },
        "reason_ar": {
          "title": "Reason Ar",
          "type": "string"
        },
        "reason_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason En"
        },
        "method": {
          "default": "DGDA criteria, weights ASSUMED (hadaq_agents.priority)",
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "score",
        "criteria",
        "escalation",
        "reason_ar"
      ],
      "title": "Priority",
      "type": "object"
    },
    "PriorityCriteria": {
      "description": "DGDA's criteria in their order, each 0..1.",
      "properties": {
        "safety": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Safety",
          "type": "number"
        },
        "active": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Active",
          "type": "number"
        },
        "water_before_rain": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Water Before Rain",
          "type": "number"
        },
        "severity_x_area": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Severity X Area",
          "type": "number"
        },
        "value": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "location": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Location",
          "type": "number"
        }
      },
      "title": "PriorityCriteria",
      "type": "object"
    },
    "Provenance": {
      "enum": [
        "measured",
        "derived",
        "model_output",
        "assumed",
        "synthetic"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "Review": {
      "properties": {
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "accepted",
            "corrected",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By"
        },
        "at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "corrected_type": {
          "anyOf": [
            {
              "enum": [
                "plaster_loss",
                "crack",
                "base_erosion",
                "rain_grooves",
                "salt_efflorescence",
                "voids_burrows",
                "structural_deformation",
                "incompatible_repair",
                "parapet_loss",
                "timber_decay",
                "biological_growth"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corrected Type"
        },
        "corrected_severity": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corrected Severity"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "Review",
      "type": "object"
    },
    "WorkOrderDraft": {
      "properties": {
        "work_order_id": {
          "title": "Work Order Id",
          "type": "string"
        },
        "inspection_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inspection Id"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Finding Ids",
          "type": "array"
        },
        "location": {
          "$ref": "#/$defs/WorkOrderLocation"
        },
        "treatment_id": {
          "title": "Treatment Id",
          "type": "string"
        },
        "steps_ar": {
          "items": {
            "type": "string"
          },
          "title": "Steps Ar",
          "type": "array"
        },
        "steps_en": {
          "items": {
            "type": "string"
          },
          "title": "Steps En",
          "type": "array"
        },
        "materials_ar": {
          "items": {
            "type": "string"
          },
          "title": "Materials Ar",
          "type": "array"
        },
        "materials_en": {
          "items": {
            "type": "string"
          },
          "title": "Materials En",
          "type": "array"
        },
        "tools_ar": {
          "items": {
            "type": "string"
          },
          "title": "Tools Ar",
          "type": "array"
        },
        "tools_en": {
          "items": {
            "type": "string"
          },
          "title": "Tools En",
          "type": "array"
        },
        "fix_water_source_first": {
          "default": false,
          "title": "Fix Water Source First",
          "type": "boolean"
        },
        "citation": {
          "$ref": "#/$defs/Citation"
        },
        "escalation": {
          "enum": [
            "urgent",
            "high",
            "medium",
            "low"
          ],
          "title": "Escalation",
          "type": "string"
        },
        "status": {
          "default": "draft_needs_field_check",
          "enum": [
            "draft_needs_field_check",
            "approved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "finding_ids",
        "location",
        "treatment_id",
        "steps_ar",
        "citation",
        "escalation"
      ],
      "title": "WorkOrderDraft",
      "type": "object"
    },
    "WorkOrderLocation": {
      "properties": {
        "building_id": {
          "title": "Building Id",
          "type": "string"
        },
        "wall_id": {
          "title": "Wall Id",
          "type": "string"
        },
        "zone_ids": {
          "items": {
            "type": "string"
          },
          "title": "Zone Ids",
          "type": "array"
        },
        "box_wall_m": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Box Wall M"
        }
      },
      "required": [
        "building_id",
        "wall_id",
        "zone_ids"
      ],
      "title": "WorkOrderLocation",
      "type": "object"
    }
  },
  "description": "AI worker -> core API: POST /api/v2/captures/{id}/results.\n\nSent as multipart: `results` (this JSON) + `rectified` (the rectified JPEG, optional).",
  "properties": {
    "capture_id": {
      "title": "Capture Id",
      "type": "string"
    },
    "ok": {
      "default": true,
      "title": "Ok",
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "scale": {
      "default": "relative",
      "enum": [
        "absolute",
        "relative"
      ],
      "title": "Scale",
      "type": "string"
    },
    "px_per_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Px Per M"
    },
    "faces_hidden_server": {
      "default": 0,
      "title": "Faces Hidden Server",
      "type": "integer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "work_orders": {
      "items": {
        "$ref": "#/$defs/WorkOrderDraft"
      },
      "title": "Work Orders",
      "type": "array"
    },
    "summary_ar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary Ar"
    },
    "summary_en": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary En"
    },
    "detector": {
      "title": "Detector",
      "type": "string"
    },
    "chain": {
      "default": "hadaq_agents.chain@v1",
      "title": "Chain",
      "type": "string"
    }
  },
  "required": [
    "capture_id",
    "detector"
  ],
  "title": "CaptureResults",
  "type": "object"
}
